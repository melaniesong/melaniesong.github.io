---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;

const pathname = Astro.url.pathname;
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <nav class="max-w-7xl mx-auto px-6 sm:px-8 py-4">
    <div class="flex items-center justify-between">
      <!-- Optional: Brand / Name -->
      <a href="/" class="font-medium text-gray-900">
        {siteConfig?.name ?? "Home"}
      </a>

      <!-- Mobile button -->
      <button
        id="navToggle"
        class="md:hidden inline-flex items-center justify-center rounded-xl border border-gray-200 bg-white/70 px-3 py-2 text-gray-700 hover:text-[#919EC6] transition-colors"
        aria-controls="navMenu"
        aria-expanded="false"
      >
        <span class="sr-only">Open menu</span>
        <!-- Hamburger icon -->
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>

      <!-- Desktop menu -->
      <ul class="hidden md:flex items-center gap-8 justify-center">
        <li>
          <a
            href="/"
            class={`font-medium transition-colors duration-300 ${
              pathname === "/"
                ? "text-[#F7C2C8]"
                : "text-gray-700 hover:text-[#919EC6]"
            }`}
          >
            Home
          </a>
        </li>

        <li>
          <a
            href="/about"
            class={`font-medium transition-colors duration-300 ${
              pathname === "/about"
                ? "text-[#F7C2C8]"
                : "text-gray-700 hover:text-[#919EC6]"
            }`}
          >
            About
          </a>
        </li>

        {hasProjects && (
          <li>
            <a
              href="/projects"
              class={`font-medium transition-colors duration-300 ${
                pathname === "/projects"
                  ? "text-[#F7C2C8]"
                  : "text-gray-700 hover:text-[#919EC6]"
              }`}
            >
              Projects
            </a>
          </li>
        )}

        <li>
          <a
            href="/art"
            class={`font-medium transition-colors duration-300 ${
              pathname === "/art"
                ? "text-[#F7C2C8]"
                : "text-gray-700 hover:text-[#919EC6]"
            }`}
          >
            Art
          </a>
        </li>
      </ul>
    </div>

    <!-- Mobile dropdown menu -->
    <div id="navMenu" class="md:hidden hidden mt-3 rounded-2xl border border-gray-200 bg-white/90 backdrop-blur-sm p-3">
      <ul class="flex flex-col gap-2">
        <li>
          <a
            href="/"
            class={`block rounded-xl px-3 py-2 font-medium transition-colors duration-300 ${
              pathname === "/"
                ? "text-[#F7C2C8]"
                : "text-gray-700 hover:text-[#919EC6]"
            }`}
          >
            Home
          </a>
        </li>

        <li>
          <a
            href="/about"
            class={`block rounded-xl px-3 py-2 font-medium transition-colors duration-300 ${
              pathname === "/about"
                ? "text-[#F7C2C8]"
                : "text-gray-700 hover:text-[#919EC6]"
            }`}
          >
            About
          </a>
        </li>

        {hasProjects && (
          <li>
            <a
              href="/projects"
              class={`block rounded-xl px-3 py-2 font-medium transition-colors duration-300 ${
                pathname === "/projects"
                  ? "text-[#F7C2C8]"
                  : "text-gray-700 hover:text-[#919EC6]"
              }`}
            >
              Projects
            </a>
          </li>
        )}

        <li>
          <a
            href="/art"
            class={`block rounded-xl px-3 py-2 font-medium transition-colors duration-300 ${
              pathname === "/art"
                ? "text-[#F7C2C8]"
                : "text-gray-700 hover:text-[#919EC6]"
            }`}
          >
            Art
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  // scroll background
  window.addEventListener("scroll", () => {
    const header = document.getElementById("header");
    if (window.scrollY > 100) {
      header?.classList.add("bg-white/80", "backdrop-blur-sm");
    } else {
      header?.classList.remove("bg-white/80", "backdrop-blur-sm");
    }
  });

  // mobile menu toggle
  const toggle = document.getElementById("navToggle");
  const menu = document.getElementById("navMenu");

  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    toggle?.setAttribute("aria-expanded", String(isHidden));
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>


