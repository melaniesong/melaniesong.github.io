---
import { siteConfig } from "../config";
---

<div
  id="hero"
  class="relative isolate overflow-hidden bg-white py-24 md:h-screen"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <!-- Gradient overlay -->
  <div
    class="absolute inset-0 -z-10"
    style={`background: radial-gradient(ellipse 800px 1200px at 0% 0%, ${siteConfig.accentColor}40 0%, ${siteConfig.accentColor}25 20%, ${siteConfig.accentColor}10 40%, rgba(255, 255, 255, 0.3) 70%, rgba(255, 255, 255, 0.8) 90%, white 100%)`}
  >
  </div>
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full stroke-gray-200 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
  >
    <defs>
      <pattern
        x="50%"
        y={-1}
        id="0787a7c5-978c-4f66-83c7-11c213f99cb7"
        width={200}
        height={200}
        patternUnits="userSpaceOnUse"
      >
        <path d="M.5 200V.5H200" fill="none"></path>
      </pattern>
      <pattern
        id="programming-symbols"
        x="0"
        y="0"
        width="400"
        height="400"
        patternUnits="userSpaceOnUse"
      >
        <text
          x="50"
          y="50"
          fill={siteConfig.accentColor}
          font-family="monospace"
          font-size="24"
          transform="rotate(-15)">&lt;/&gt;</text
        >
        <text
          x="150"
          y="100"
          fill={siteConfig.accentColor}
          font-family="monospace"
          font-size="20"
          transform="rotate(10)">{}</text
        >
        <text
          x="250"
          y="80"
          fill={siteConfig.accentColor}
          font-family="monospace"
          font-size="18"
          transform="rotate(-5)">=&gt;</text
        >
        <text
          x="100"
          y="200"
          fill={siteConfig.accentColor}
          font-family="monospace"
          font-size="22"
          transform="rotate(15)">[]</text
        >
        <text
          x="300"
          y="180"
          fill={siteConfig.accentColor}
          font-family="monospace"
          font-size="20"
          transform="rotate(-10)">&lt;&gt;</text
        >
        <text
          x="200"
          y="250"
          fill={siteConfig.accentColor}
          font-family="monospace"
          font-size="24"
          transform="rotate(5)">()</text
        >
        <text
          x="50"
          y="320"
          fill={siteConfig.accentColor}
          font-family="monospace"
          font-size="18"
          transform="rotate(-8)">::</text
        >
        <text
          x="350"
          y="300"
          fill={siteConfig.accentColor}
          font-family="monospace"
          font-size="22"
          transform="rotate(12)">==</text
        >
        <text
          x="150"
          y="350"
          fill={siteConfig.accentColor}
          font-family="monospace"
          font-size="20"
          transform="rotate(-15)">++</text
        >
        <text
          x="250"
          y="370"
          fill={siteConfig.accentColor}
          font-family="monospace"
          font-size="24"
          transform="rotate(8)">;</text
        >
      </pattern>
    </defs>
    <rect
      fill="url(#programming-symbols)"
      width="100%"
      height="100%"
      opacity="0.2"></rect>
    <rect
      fill="url(#0787a7c5-978c-4f66-83c7-11c213f99cb7)"
      width="100%"
      height="100%"
      stroke-width={0}></rect>
  </svg>
  <div class="h-full mx-auto p-8 sm:p-12 md:p-24 flex items-center">
    <div
      id="hero-typing-root"
      data-name={siteConfig.name}
      data-accent={siteConfig.accentColor}
    >
      <h2
        id="hero-line-1"
        class="text-pretty text-xl sm:text-2xl md:text-5xl font-bold tracking-tight text-gray-700 min-h-[1.2em]"
        aria-live="polite"
      >
        <span id="hero-typing-line-1"></span><span
          id="hero-cursor-line-1"
          class="typing-cursor"
          aria-hidden="true"></span>
      </h2>
      <h1
        id="hero-line-2"
        class="mt-6 sm:mt-8 md:mt-10 text-pretty text-4xl sm:text-5xl md:text-6xl lg:text-8xl font-bold tracking-tight text-gray-800 min-h-[1.2em]"
      >
        <span id="hero-typing-line-2"></span><span
          id="hero-cursor-line-2"
          class="typing-cursor"
          style="display: none"
          aria-hidden="true"></span>
      </h1>
      <p
        id="hero-subtitle"
        class="hero-subtitle mt-4 sm:mt-6 md:mt-8 text-pretty text-base sm:text-lg md:text-xl/8 font-medium text-gray-600"
      >
        {siteConfig.title}
      </p>
    </div>
  </div>
  <div
    id="hero-social"
    class="hero-social absolute bottom-0 left-0 right-0 p-8 sm:p-12 md:p-24 flex gap-x-4 sm:gap-x-6 md:gap-x-8 text-gray-700"
  >
    {
      siteConfig.social?.email && (
        <a
          href={`mailto:${siteConfig.social.email}`}
          aria-label="Email"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
            <path d="M3 7l9 6l9 -6" />
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.linkedin && (
        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M8 11v5" />
              <path d="M8 8v.01" />
              <path d="M12 16v-5" />
              <path d="M16 16v-3a2 2 0 1 0 -4 0" />
              <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
            </>
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.twitter && (
        <a
          href={siteConfig.social.twitter}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Twitter"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
              <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
            </>
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.github && (
        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
            </>
          </svg>
        </a>
      )
    }
  </div>
  <div class="absolute bottom-0 left-0 right-0 p-8 sm:p-12 md:p-24">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 flex justify-end">
      <div class="flex items-center gap-8">
        <span
          class="hidden md:inline invisible font-medium pointer-events-none select-none"
          aria-hidden="true">Home</span
        >
        <span
          class="hidden md:inline invisible font-medium pointer-events-none select-none"
          aria-hidden="true">About</span
        >
        <a
          id="hero-scroll-hint"
          href="#projects"
          class="hero-scroll-hint flex items-center gap-1.5 text-sm sm:text-base font-medium text-gray-500 transition-colors duration-300 hover:text-gray-700"
        >
          See my projects
          <span class="hero-scroll-arrow" aria-hidden="true">↓</span>
        </a>
        <span
          class="hidden md:inline invisible font-medium pointer-events-none select-none"
          aria-hidden="true">Art</span
        >
      </div>
    </div>
  </div>
</div>

<style>
  .typing-cursor {
    display: inline-block;
    width: 3px;
    height: 0.85em;
    margin-left: 2px;
    vertical-align: baseline;
    background-color: var(--accent-color);
    animation: blink 0.9s step-end infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .hero-subtitle {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.7s ease-out,
      transform 0.7s ease-out;
  }

  .hero-subtitle--visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-social {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.7s ease-out 0.15s,
      transform 0.7s ease-out 0.15s;
  }

  .hero-social--visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-scroll-hint {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.7s ease-out 0.25s,
      transform 0.7s ease-out 0.25s;
  }

  .hero-scroll-hint--visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-scroll-arrow {
    display: inline-block;
    animation: bounce-down 1.6s ease-in-out infinite;
  }

  @keyframes bounce-down {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-arrow {
      animation: none;
    }
  }
</style>

<script>
  function delay(ms: number) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  function showHeroExtras() {
    document.getElementById("hero-subtitle")?.classList.add("hero-subtitle--visible");
    document.getElementById("hero-social")?.classList.add("hero-social--visible");
    document.getElementById("hero-scroll-hint")?.classList.add("hero-scroll-hint--visible");
  }

  async function typeHeroGreeting() {
    const root = document.getElementById("hero-typing-root");
    const line1El = document.getElementById("hero-typing-line-1");
    const line2El = document.getElementById("hero-typing-line-2");
    const cursor1 = document.getElementById("hero-cursor-line-1");
    const cursor2 = document.getElementById("hero-cursor-line-2");

    if (!root || !line1El || !line2El || !cursor1 || !cursor2) return;

    const name = root.dataset.name ?? "";
    const accent = root.dataset.accent ?? "#919EC6";
    const greeting = "Hello! 👋";
    const namePrefix = "I'm ";
    const charDelay = 55;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      line1El.textContent = greeting;
      line2El.innerHTML = `${namePrefix}<span style="color: ${accent}">${name}</span>`;
      cursor1.style.display = "none";
      cursor2.style.display = "none";
      showHeroExtras();
      return;
    }

    for (const char of greeting) {
      line1El.textContent += char;
      await delay(charDelay);
    }

    cursor1.style.display = "none";
    cursor2.style.display = "inline-block";

    for (const char of namePrefix) {
      line2El.textContent += char;
      await delay(charDelay);
    }

    const nameSpan = document.createElement("span");
    nameSpan.style.color = accent;
    line2El.appendChild(nameSpan);

    for (const char of name) {
      nameSpan.textContent += char;
      await delay(charDelay);
    }

    cursor2.style.display = "none";
    showHeroExtras();
  }

  typeHeroGreeting();
</script>
