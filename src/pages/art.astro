---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

const artworks = [
  { src: "/art/art-1.jpg", alt: "Artwork 1", title: "Untitled 01", year: "2024" },
  { src: "/art/art-2.jpg", alt: "Artwork 2", title: "Untitled 02", year: "2024" },
  { src: "/art/art-3.jpg", alt: "Artwork 3", title: "Untitled 03", year: "2023" },
  { src: "/art/art-4.jpg", alt: "Artwork 4", title: "Untitled 04", year: "2023" },
  { src: "/art/art-5.jpg", alt: "Artwork 5", title: "Untitled 05", year: "2022" },
  { src: "/art/art-6.jpg", alt: "Artwork 6", title: "Untitled 06", year: "2022" },
  { src: "/art/art-7.jpg", alt: "Artwork 7", title: "Untitled 07", year: "2022" },
  { src: "/art/art-8.jpg", alt: "Artwork 8", title: "Untitled 08", year: "2021" },
  { src: "/art/art-9.jpg", alt: "Artwork 9", title: "Untitled 09", year: "2021" },
  { src: "/art/art-10.jpg", alt: "Artwork 10", title: "Untitled 10", year: "2021" },
  { src: "/art/art-11.jpg", alt: "Artwork 11", title: "Untitled 11", year: "2020" },
  { src: "/art/art-12.jpg", alt: "Artwork 12", title: "Untitled 12", year: "2020" },
  { src: "/art/art-13.jpg", alt: "Artwork 13", title: "Untitled 13", year: "2020" },
  { src: "/art/art-14.jpg", alt: "Artwork 14", title: "Untitled 14", year: "2019" },
  { src: "/art/art-15.jpg", alt: "Artwork 15", title: "Untitled 15", year: "2019" },
  { src: "/art/art-16.jpg", alt: "Artwork 16", title: "Untitled 16", year: "2019" },
  { src: "/art/art-17.jpg", alt: "Artwork 17", title: "Untitled 17", year: "2018" },
  { src: "/art/art-18.jpg", alt: "Artwork 18", title: "Untitled 18", year: "2018" },
];

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteConfig.description} />
    <title>{siteConfig.name} - Art</title>
  </head>

  <body>
    <Header />

    <section class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div class="max-w-7xl mx-auto">
        <h1 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
          Art
        </h1>

        <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {artworks.map((a) => (
            <figure class="bg-gray-50 rounded-2xl border border-gray-200 overflow-hidden">
              <img src={a.src} alt={a.alt} class="w-full h-72 object-cover" loading="lazy" />
              <figcaption class="p-4">
                <div class="font-medium text-gray-900">{a.title}</div>
                {a.year && <div class="text-sm text-gray-600 mt-1">{a.year}</div>}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <Footer />
  </body>
</html>
