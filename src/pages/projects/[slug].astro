---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { siteConfig } from "../../config";
import "../../styles/global.css";

export async function getStaticPaths() {
  const projectFiles = await Astro.glob("../../content/projects/*.md");

  return projectFiles.map((file) => {
    const slug = file.file.split("/").pop()?.replace(".md", "") ?? "";
    return { params: { slug }, props: { file } };
  });
}

const { file } = Astro.props;
const { frontmatter } = file;
const { Content } = file;

// Safe fallbacks
const title = frontmatter.title ?? "Project";
const summary = frontmatter.summary ?? "";
const intro = frontmatter.intro ?? "";
const role = frontmatter.role ?? "";
const team = frontmatter.team ?? "";
const timeline = frontmatter.timeline ?? "";
const client = frontmatter.client ?? "";
const tools = Array.isArray(frontmatter.tools) ? frontmatter.tools : [];
const skills = Array.isArray(frontmatter.skills) ? frontmatter.skills : [];
const outcomes = Array.isArray(frontmatter.outcomes) ? frontmatter.outcomes : [];
const metrics = Array.isArray(frontmatter.metrics) ? frontmatter.metrics : [];
const links = frontmatter.links ?? {};
const cover = frontmatter.cover ?? "";
const gallery = Array.isArray(frontmatter.gallery) ? frontmatter.gallery : [];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={summary || siteConfig.description} />
    <title>{title} - {siteConfig.name}</title>
  </head>

  <body>
    <Header />
    
    <section class="px-6 py-10 sm:px-10 sm:py-14 lg:px-16 lg:py-20">
        <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
            <!-- Left column: title + summary + meta -->
            <div class="lg:col-span-6">
               
                <a href="/projects" class="text-sm text-gray-600 hover:text-gray-900">
                ← Back to Projects
                </a>

                <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900">
                {title}
                </h1>

                {summary && (
                <p class="mt-4 text-base sm:text-lg text-gray-600 leading-relaxed">
                    {summary}
                </p>
                )}
                {intro && (
                    <p class="mt-6 text-base text-gray-700 leading-relaxed">
                        {intro}
                    </p>
                    )}

                {(role || team || timeline || client) && (
                <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
                    {role && (
                    <div class="rounded-2xl border border-gray-200 bg-gray-50 p-4">
                        <div class="text-xs uppercase tracking-wide text-gray-500">Role</div>
                        <div class="mt-1 text-gray-900 font-medium">{role}</div>
                    </div>
                    )}
                    {timeline && (
                    <div class="rounded-2xl border border-gray-200 bg-gray-50 p-4">
                        <div class="text-xs uppercase tracking-wide text-gray-500">Timeline</div>
                        <div class="mt-1 text-gray-900 font-medium">{timeline}</div>
                    </div>
                    )}
                    {team && (
                    <div class="rounded-2xl border border-gray-200 bg-gray-50 p-4">
                        <div class="text-xs uppercase tracking-wide text-gray-500">Team</div>
                        <div class="mt-1 text-gray-900 font-medium">{team}</div>
                    </div>
                    )}
                    {client && (
                    <div class="rounded-2xl border border-gray-200 bg-gray-50 p-4">
                        <div class="text-xs uppercase tracking-wide text-gray-500">Client</div>
                        <div class="mt-1 text-gray-900 font-medium">{client}</div>
                    </div>
                    )}
                </div>
                )}

                {(tools.length > 0 || skills.length > 0) && (
                <div class="mt-10 space-y-6">
                    {tools.length > 0 && (
                    <div>
                        <div class="text-sm font-semibold text-gray-900">Tools</div>
                        <div class="mt-3 flex flex-wrap gap-2">
                        {tools.map((t) => (
                            <span class="px-3 py-1 bg-gray-900 text-white rounded-lg text-xs font-medium">
                            {t}
                            </span>
                        ))}
                        </div>
                    </div>
                    )}

                    {skills.length > 0 && (
                    <div>
                        <div class="text-sm font-semibold text-gray-900">Skills</div>
                        <div class="mt-3 flex flex-wrap gap-2">
                        {skills.map((s) => (
                            <span class="px-3 py-1 rounded-lg text-xs font-medium border border-gray-200 bg-white text-gray-900">
                            {s}
                            </span>
                        ))}
                        </div>
                    </div>
                    )}
                </div>
                )}
            </div>

            <!-- Right column: cover + outcomes/metrics + gallery preview -->
            <div class="lg:col-span-6">
                {cover && (
                <img
                    src={cover}
                    alt={`${title} cover`}
                    class="w-full rounded-2xl border border-gray-200"
                    loading="lazy"
                />
                )}

                {(outcomes.length > 0 || metrics.length > 0) && (
                <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
                    {outcomes.length > 0 && (
                    <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6">
                        <div class="text-sm font-semibold text-gray-900">Outcomes</div>
                        <ul class="mt-4 space-y-2 text-gray-700">
                        {outcomes.map((o) => (
                            <li class="flex gap-3">
                            <span class="mt-2 w-1.5 h-1.5 rounded-full bg-gray-900"></span>
                            <span>{o}</span>
                            </li>
                        ))}
                        </ul>
                    </div>
                    )}

                    {metrics.length > 0 && (
                    <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6">
                        <div class="text-sm font-semibold text-gray-900">Metrics</div>
                        <div class="mt-4 space-y-3">
                        {metrics.map((m) => (
                            <div class="flex items-baseline justify-between gap-4">
                            <div class="text-gray-700">{m.label}</div>
                            <div class="text-gray-900 font-semibold">{m.value}</div>
                            </div>
                        ))}
                        </div>
                    </div>
                    )}
                </div>
                )}

                {gallery.length > 0 && (
                <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {gallery.slice(0, 4).map((src) => (
                    <img
                        src={src}
                        alt=""
                        class="w-full rounded-2xl border border-gray-200"
                        loading="lazy"
                    />
                    ))}
                </div>
                )}
            </div>
            </div>

        {/* Main write-up */}
        <article class="prose prose-neutral mt-12 max-w-none">
          <Content />
        </article>
      </div>
    </section>

    <Footer />
  </body>
</html>
